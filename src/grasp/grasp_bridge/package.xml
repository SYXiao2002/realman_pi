<?xml version="1.0"?>
<package format="3">
  <name>grasp_bridge</name><version>0.1.0</version>
  <description>Planning-only RGB-D adapter for a ROS-independent grasp server.</description>
  <maintainer email="maintainer@example.com">RealMan maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>realman_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
