<?xml version="1.0"?>
<!-- Profile-derived arm/actions are resolved by the launcher before preflight.
     SUCCESS means the command sequence ended, not a verified physical grasp.
     Cancel/failure never opens the gripper. During an active loop, monitor it from :8765. -->
<root main_tree_to_execute="MainTree"
      realman_arm_id="r" realman_required_arms="r"
      realman_required_actions="execute_motion" realman_launch="arm_move"
      realman_stop_on_terminal="false" realman_exit_on_terminal="false">
  <BehaviorTree ID="MainTree">
    <TaskLease name="grasp_task" arm_id="{arm_id}" dry_run="{dry_run}"
               ttl_sec="{grasp_lease_ttl_sec}" timeout_sec="{grasp_acquire_timeout_sec}">
      <Repeat name="grasp_loop" num_cycles="{grasp_cycles}">
        <Retry name="wrist_grasp_retry" num_attempts="3">
          <Sequence name="wrist_grasp">
            <TaskGripper name="prepare_gripper" gripper="{grasp_gripper}" command="open" dry_run="{dry_run}" timeout_sec="{grasp_gripper_timeout_sec}"/>
            <MoveJ name="observe" arm_id="{arm_id}" dry_run="{dry_run}" joint_degrees="{grasp_observation_joint_degrees}" velocity_percent="{grasp_velocity_percent}" timeout_sec="{grasp_motion_timeout_sec}"/>
            <PlanGrasp name="plan_grasp" dry_run="{dry_run}" profile_name="{grasp_profile_name}" profile_id="{grasp_profile_id}" base_frame="{grasp_base_frame}" tool_name="{grasp_tool_name}" target_label="{grasp_target_label}" backend="{grasp_backend}" timeout_sec="{grasp_plan_timeout_sec}"/>
            <!-- Best-effort right-wrist snapshots, one per grasp phase, saved into
                 per-phase subfolders (after_plan/after_close/after_lift). camera_right is
                 the right WRIST CAM (config/ros/cameras_ros2.yaml; the right_wrist
                 profile's color_topic). allow_failure=true records a missed frame as an
                 ERROR diagnostic but returns SUCCESS, so a snapshot never fails the grasp
                 or re-runs this sequence (which would reopen the gripper). These follow
                 {dry_run}: a dry-run only validates the ports and captures nothing. -->
            <SaveCameraFrames name="save_after_plan"
                              image_topics="/camera_right/color/image_raw"
                              directory="/opt/rm65_ws/logs/snapshots/after_plan"
                              service_name="/camera_snapshot/save"
                              timeout_sec="8.0"
                              allow_failure="true"
                              session_id="{grasp_session}"
                              dry_run="{dry_run}"/>
            <GraspWaypoint name="approach" arm_id="{arm_id}" waypoint="pregrasp" dry_run="{dry_run}" velocity_percent="{grasp_velocity_percent}" timeout_sec="{grasp_motion_timeout_sec}" result_grace_sec="{grasp_motion_result_grace_sec}"/>
            <GraspWaypoint name="grasp_pose" arm_id="{arm_id}" waypoint="grasp" dry_run="{dry_run}" velocity_percent="{grasp_velocity_percent}" timeout_sec="{grasp_motion_timeout_sec}" result_grace_sec="{grasp_motion_result_grace_sec}"/>
            <TaskGripper name="close_gripper" gripper="{grasp_gripper}" command="close" dry_run="{dry_run}" timeout_sec="{grasp_gripper_timeout_sec}"/>
            <!-- Gripper closed: capture what the right wrist cam actually holds. -->
            <SaveCameraFrames name="save_after_close"
                              image_topics="/camera_right/color/image_raw"
                              directory="/opt/rm65_ws/logs/snapshots/after_close"
                              service_name="/camera_snapshot/save"
                              timeout_sec="8.0"
                              allow_failure="true"
                              session_id="{grasp_session}"
                              dry_run="{dry_run}"/>
            <GraspWaypoint name="lift" arm_id="{arm_id}" waypoint="lift" dry_run="{dry_run}" velocity_percent="{grasp_velocity_percent}" timeout_sec="{grasp_motion_timeout_sec}" result_grace_sec="{grasp_motion_result_grace_sec}"/>
            <!-- After lift: capture the held object clear of the surface. -->
            <SaveCameraFrames name="save_after_lift"
                              image_topics="/camera_right/color/image_raw"
                              directory="/opt/rm65_ws/logs/snapshots/after_lift"
                              service_name="/camera_snapshot/save"
                              timeout_sec="8.0"
                              allow_failure="true"
                              session_id="{grasp_session}"
                              dry_run="{dry_run}"/>
            <GraspHold name="hold_unverified" dry_run="{dry_run}" duration_sec="{grasp_hold_sec}"/>
            <MoveJ name="return_object" arm_id="{arm_id}" dry_run="{dry_run}" joint_degrees="{grasp_return_joint_degrees}" velocity_percent="{grasp_velocity_percent}" timeout_sec="{grasp_motion_timeout_sec}"/>
            <TaskGripper name="release_object" gripper="{grasp_gripper}" command="open" dry_run="{dry_run}" timeout_sec="{grasp_gripper_timeout_sec}"/>
          </Sequence>
        </Retry>
      </Repeat>
    </TaskLease>
  </BehaviorTree>
</root>
